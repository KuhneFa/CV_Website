{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Controllers/**",
      "Middleware/**",
      "Models/**",
      "Services/**",
      "Program.cs",
      "CV_Website.csproj",
      "Dockerfile",
      "docker-entrypoint.sh",
      ".dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
